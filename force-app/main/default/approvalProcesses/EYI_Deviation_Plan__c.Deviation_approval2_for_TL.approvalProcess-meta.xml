<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>EYI_DAF_Type__c</field>
        <field>EYI_Status__c</field>
        <field>EYI_Project__c</field>
        <field>EYI_Tower__c</field>
        <field>EYI_Source__c</field>
        <field>EYI_Quote__c</field>
        <field>EYI_Opportunity_Name__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved_by_Head</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>Deviation Form Approved by Head</description>
        <label>Functional Head Approval</label>
        <name>Approved_by_Head</name>
        <rejectionActions>
            <action>
                <name>Rejected_By_Functional_Head</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Final Approval</label>
        <name>Approved_by_Final_Approver</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Rejected_By_Final_Approver</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>unfiled$public/Deviation_Form_Approval_Notification2</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND( !ISBLANK( EYI_Opportunity_Name__c ) ,!ISBLANK( EYI_Quote__c ),!ISBLANK( EYI_Project__c ),CONTAINS(Owner:User.UserRole.Name, &quot;Sourcing TL&quot;))</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved_by_the_Final_Approver</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Final_Approved_Check_True</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Final_Approved_Checkox_True</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Final_Approver_Status_as_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Submitted_Approval</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_FA</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Deviation approval2 for TL</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
