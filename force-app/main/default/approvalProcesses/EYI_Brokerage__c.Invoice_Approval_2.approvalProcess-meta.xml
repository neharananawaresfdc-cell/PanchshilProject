<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>EYI_Approved_Hold_On__c</field>
        <field>EYI_Opportunity__c</field>
        <field>EYI_REC_Account__c</field>
        <field>EYI_Booking__c</field>
        <field>Project__c</field>
        <field>Unit_Details__c</field>
        <field>EYI_Brokerage_percentage__c</field>
        <field>EYI_Brokerage_Type__c</field>
        <field>EYI_Appartment_Value__c</field>
        <field>EYI_Total_Brokerage_Amount__c</field>
        <field>Stages__c</field>
        <field>Invoice_Number__c</field>
        <field>EYI_Invoice_Status__c</field>
        <field>EYI_Invoice_Letter_Uploaded__c</field>
        <field>EYI_Invoice_Approval_Status__c</field>
        <field>Sourcing_TL_User__c</field>
        <field>Sourcing_Head_User__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Invoice_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Sourcing_TL_User__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Sales Approval</label>
        <name>Sales_Approval</name>
        <rejectionActions>
            <action>
                <name>Update_Invoice_Approval_Reject_by_Status</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Stage_Update</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Invoice_Approval_by_Head_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Sourcing_Head_User__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Sales Approve</label>
        <name>Sales_Approve</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Invoice_Rejected_Email_alert</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_Invoice_Rejected_by_Head_Status</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Finance_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Invoice_Approval_by_Financ_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>financeuser@in.ey.com.newuat</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Finance Approve</label>
        <name>Finance_Approve</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Invoice_Rejected_Email_alert</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_Rejected_by_Finance_Status</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>EYI_Brokerage__c.Stages__c</field>
            <operation>equals</operation>
            <value>Invoice Received</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Invoice_Approval_Status_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Invoice Approval 2</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
