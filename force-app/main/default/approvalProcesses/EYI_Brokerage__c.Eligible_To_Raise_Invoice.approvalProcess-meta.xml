<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>EYI_Opportunity__c</field>
        <field>Stages__c</field>
        <field>EYI_REC_Account__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Eligible_to_Raise_Invoice</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Invoice_Checklist_Accept_Status</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Stage</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>crmadmin@in.ey.com.uatorg</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Check Invoice Checklist</label>
        <name>Step_1</name>
        <rejectionActions>
            <action>
                <name>Invoice_Checklist_Status_Update</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Not_Eligible_to_Raise_Invoice</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>EYI_Brokerage__c.Stages__c</field>
            <operation>equals</operation>
            <value>Booking Registration Done</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Eligible To Raise Invoice</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
