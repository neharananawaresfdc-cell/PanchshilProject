<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Sales_Head</submitter>
        <type>role</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Sales_Manager</submitter>
        <type>role</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Sourcing_Head_1</submitter>
        <type>role</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Sourcing_Head_2</submitter>
        <type>role</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Sourcing_Manager_1</submitter>
        <type>role</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
        <field>EYI_Opportunity__c</field>
        <field>EYI_Cancellation_Decision__c</field>
        <field>EYI_Remark_For_Finance__c</field>
        <field>EYI_Cancellation_Remarks__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Cancellation_Approved_by_Head</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>EYI_Closing_Head__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Case.EYI_Case_Approval_Status__c</field>
                <operation>equals</operation>
                <value>Approved by Functional Head</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Cancellation Approval to Sales Head</label>
        <name>Approved_by_Function_Head</name>
        <rejectionActions>
            <action>
                <name>Cancellation_Rejected_by_Head</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Cancellation_Approved_by_SC_Head</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_by_S_C_Approved_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>S_C_User__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Case.EYI_Cancellation_Approval_Status__c</field>
                <operation>equals</operation>
                <value>Approved by Functional Head</value>
            </criteriaItems>
        </entryCriteria>
        <label>Cancellation Approval to S &amp; C Head</label>
        <name>Approved_by_S_C_Head</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Cancellation_Rejected_by_SC_Head</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>New Cancellation Approval Process.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Case.EYI_Cancellation_Approval_Status__c</field>
            <operation>notEqual</operation>
            <value>Approved by S&amp;C Head</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Cancellation_Approval_Date_Update</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Case_Cancellation_Approved_Stage</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Final_Cancellation_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_Cancellation_Submitted_Status</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Stage_for_Cancellation</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Cancellation Deviation Approval for SM</label>
    <processOrder>3</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
