<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>EYI_First_Name__c</field>
        <field>EYI_Last_Name__c</field>
        <field>EYI_Email__c</field>
        <field>EYI_REC_Status__c</field>
        <field>EYI_REC_Approval_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>REC_Approval_Status_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Approved_notification_to_SM_Head</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>REC Account approval by TL</description>
        <entryCriteria>
            <criteriaItems>
                <field>EYI_REC__c.EYI_Registration_Status__c</field>
                <operation>equals</operation>
                <value>Unregistered</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Approval by TL</label>
        <name>Approval_by_TL</name>
        <rejectionActions>
            <action>
                <name>REC_Approval_Status_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Rejected_Notification_to_Head</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>REC_Approval_Status_Update_to_Head</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Registration_Approval_Email_to_SM_and_TL</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>Approval by Head</description>
        <entryCriteria>
            <criteriaItems>
                <field>EYI_REC__c.EYI_Registration_Status__c</field>
                <operation>equals</operation>
                <value>Unregistered</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Approval by Head</label>
        <name>Approval_by_Head</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>REC_Approval_Status_Rejected_by_Head</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Approval_Notification_to_Head</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Registration_Approved_by_Finance_user</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Finance_executive</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Approval to Finance user</description>
        <entryCriteria>
            <formula>true</formula>
        </entryCriteria>
        <label>Approval to Finance user</label>
        <name>Approval_to_Finance_user</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Registration_Rejected_by_Finance_user</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>This Approval Process Updates the Registration Status from unregistered to registered</description>
    <emailTemplate>Sourcing/REC_Account_Approval_Notification</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>EYI_REC__c.EYI_Registration_Status__c</field>
            <operation>equals</operation>
            <value>Unregistered</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Submitted_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Approval REC Account Unregistered to Reg</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>5</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
