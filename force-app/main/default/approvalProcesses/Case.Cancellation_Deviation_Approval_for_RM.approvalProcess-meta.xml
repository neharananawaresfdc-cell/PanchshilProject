<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>CRM_Head</submitter>
        <type>role</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
        <field>EYI_Opportunity__c</field>
        <field>EYI_Cancellation_Decision__c</field>
        <field>EYI_Remark_For_Finance__c</field>
        <field>EYI_Cancellation_Remarks__c</field>
        <field>EYI_Total_Refund_Given__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Cancellation_Approved_by_CRM_Head</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>EYI_CRM_Head__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Case.EYI_Cancellation_Approval_Status__c</field>
                <operation>equals</operation>
                <value>Submitted</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Cancellation Approval to CRM Head</label>
        <name>Approved_by_Function_Head</name>
        <rejectionActions>
            <action>
                <name>Cancellation_Rejected_by_CRM_Head</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Cancellation_Approved_by_S_C_Head_RM</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>S_C_User__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Case.EYI_Cancellation_Approval_Status__c</field>
                <operation>equals</operation>
                <value>Approved by Functional Head</value>
            </criteriaItems>
        </entryCriteria>
        <label>Cancellation Approval to S &amp; C Head</label>
        <name>Cancellation_Approval_to_S_C_Head</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Cancellation_Rejected_by_S_C_Head_RM</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>New Cancellation Approval Process.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Case.EYI_Cancellation_Approval_Status__c</field>
            <operation>notEqual</operation>
            <value>Approved by S&amp;C Head</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Cancellation_Approved_Date</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Cancellation_Approved_Stage</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Final_Cancellation_Rejected_Status</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Cancellation_Submitted_Update</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Stage_for_Cancellation</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Cancellation Deviation Approval for RM</label>
    <processOrder>4</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
