<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>EYI_First_Name__c</field>
        <field>EYI_Last_Name__c</field>
        <field>EYI_Phone__c</field>
        <field>EYI_Email__c</field>
        <field>EYI_REC_Status__c</field>
        <field>EYI_Rejection_Remark__c</field>
        <field>EYI_REC_Approval_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>REC_Approval_Status_TL_Approved11</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Approval_Notification_to_Head_1</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>REC Account approval by TL</description>
        <entryCriteria>
            <criteriaItems>
                <field>EYI_REC__c.EYI_REC_Status__c</field>
                <operation>equals</operation>
                <value>Active</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Approval by TL</label>
        <name>Approval_by_TL</name>
        <rejectionActions>
            <action>
                <name>REC_Approval_Status_TL_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Rejected_Notification_to_Sourcing_Manager_1</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>REC_Approval_Status_Update_to_Approved1</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Approved_notification_to_SM_and_TL</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>REC Account approval by Head</description>
        <entryCriteria>
            <formula>true</formula>
        </entryCriteria>
        <label>Approval by Head</label>
        <name>Approval_by_Head</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>REC_Approval_Status_Update_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Rejected_Notification_to_SM_and_TL</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>REC status is set from Active to Inactive/Duplicate/Blacklist SM send for approval to Sourcing TL and Head</description>
    <emailTemplate>Sourcing/REC_Active_to_Inactive_Duplicate_Status_Update_Notification</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>EYI_REC__c.EYI_REC_Status__c</field>
            <operation>equals</operation>
            <value>Active</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Updated_Approved_Status2</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Submitted_for_Approval_InActive</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>REC Status Active to Inactive/Dup./Black</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>4</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
