<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>EYI_First_Name__c</field>
        <field>EYI_Last_Name__c</field>
        <field>EYI_Email__c</field>
        <field>EYI_REC_Status__c</field>
        <field>EYI_REC_Approval_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>REC_Approval_Status_Update_to_Head</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Approved_notification_to_SM_Head</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>EYI_REC__c.EYI_Registration_Status__c</field>
                <operation>equals</operation>
                <value>Unregistered</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>RejectRecord</ifCriteriaNotMet>
        <label>Approval by Head</label>
        <name>Approval_by_Head</name>
        <rejectionActions>
            <action>
                <name>REC_Approval_Status_Rejected_by_Head</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Registration_rejection_notification_to_SM</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>This Approval Process Updates the Registration Status from unregistered to registered</description>
    <emailTemplate>Sourcing/REC_Account_Approval_Notification</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(
 ISPICKVAL(EYI_Registration_Status__c  , &quot;Unregistered&quot;) ,
    CONTAINS(Owner:User.UserRole.Name, &quot;Sourcing TL&quot;) 
)</formula>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Submitted_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>REC Unregistered to Reg by TL</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>6</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
