<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Business_Admin</submitter>
        <type>role</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>EYI_First_Name__c</field>
        <field>EYI_Last_Name__c</field>
        <field>EYI_Phone__c</field>
        <field>EYI_Email__c</field>
        <field>EYI_REC_Status__c</field>
        <field>EYI_Rejection_Remark__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Send_Approval_Notification_to_Head_1</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_Inactive_Active_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>REC Account approval by TL</description>
        <entryCriteria>
            <booleanFilter>1 OR 2</booleanFilter>
            <criteriaItems>
                <field>EYI_REC__c.EYI_REC_Status__c</field>
                <operation>equals</operation>
                <value>Inactive</value>
            </criteriaItems>
            <criteriaItems>
                <field>EYI_REC__c.EYI_REC_Status__c</field>
                <operation>equals</operation>
                <value>Duplicate</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Approval by TL</label>
        <name>Approval_by_TL</name>
        <rejectionActions>
            <action>
                <name>Rejected_Status_on_Ina_dup_to_Activ</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Rejected_Notification_to_Sourcing_Manager_1</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Send_Inactive_Duplicate_to_Active_Approval_Notification_to_SM_and_TL</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Status_from_Ina_Dup_to_Active</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>REC Account approval by Head</description>
        <entryCriteria>
            <criteriaItems>
                <field>User.Profile</field>
                <operation>equals</operation>
                <value>Sourcing</value>
            </criteriaItems>
        </entryCriteria>
        <label>Approval by Head</label>
        <name>Approval_by_Head</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Rejected_Status_on_Ina_dup_by_head</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_Rejected_Notification_to_SM_and_TL</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>REC status is set to Inactive, Duplicate and Blacklist SM send for approval to Sourcing TL and Head</description>
    <emailTemplate>Sourcing/REC_Inactive_Duplicate_to_Active_Status_Update_Notification</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 OR 2 OR 3</booleanFilter>
        <criteriaItems>
            <field>EYI_REC__c.EYI_REC_Status__c</field>
            <operation>equals</operation>
            <value>Inactive</value>
        </criteriaItems>
        <criteriaItems>
            <field>EYI_REC__c.EYI_REC_Status__c</field>
            <operation>equals</operation>
            <value>Duplicate</value>
        </criteriaItems>
        <criteriaItems>
            <field>EYI_REC__c.EYI_REC_Status__c</field>
            <operation>equals</operation>
            <value>Frozen</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved_Email_Notification1</name>
            <type>Alert</type>
        </action>
        <action>
            <name>REC_Status_update_to_Active</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_Inactive_Duplicate_to_Active</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Approval Status Inactive/Dup. to Active</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
