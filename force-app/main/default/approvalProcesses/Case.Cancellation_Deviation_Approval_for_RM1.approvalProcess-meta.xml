<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>CRM_Head</submitter>
        <type>role</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
        <field>EYI_Opportunity__c</field>
        <field>EYI_Case_Assigned_to_RM__c</field>
        <field>EYI_Cancellation_Reason__c</field>
        <field>EYI_Additional_Reason_for_Cancellation__c</field>
        <field>EYI_Cancellation_Request_Date__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>EYI_CRM_Head__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Case.EYI_Cancellation_Approval_Status__c</field>
                <operation>equals</operation>
                <value>Submitted</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Cancellation Approval to CRM Head</label>
        <name>Approved_by_Function_Head</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Cancellation_Approved_by_S_C_Head</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_CaseRetention_Status_after_Cancel</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>S_C_User__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Case.EYI_RM_Cancellation_Approval_Status__c</field>
                <operation>equals</operation>
                <value>Approved by Function Head</value>
            </criteriaItems>
        </entryCriteria>
        <label>Approved by S &amp; C Head</label>
        <name>Approved_by_S_C_Head</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Cancellation_Rejectedby_S_C_Head</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND (2 OR 3)</booleanFilter>
        <criteriaItems>
            <field>Case.EYI_RM_Cancellation_Approval_Status__c</field>
            <operation>notEqual</operation>
            <value>Approved by S&amp;C Head</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.EYI_Retention_Request_Sent_By__c</field>
            <operation>equals</operation>
            <value>RM</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.EYI_Retention_Request_Sent_By__c</field>
            <operation>equals</operation>
            <value>CRM Head</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_Stage_for_Cancellation</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Cancellation Deviation Approval for RM</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
