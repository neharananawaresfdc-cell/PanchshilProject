<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Relationship_Manager</submitter>
        <type>role</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Registration_Status_to_Admin_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>EYI_CRM_Admin__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>CRM Admin</label>
        <name>CRM_Admin</name>
        <rejectionActions>
            <action>
                <name>Registration_Status_to_Admin_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>RegistrationChecklistSubmitted_to_false</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Rejection_Date</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Sales_checklist_to_false</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Registration_Status_to_Head_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>OM_CRM_Head__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>CRM Head</label>
        <name>CRM_Head</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Registration_Status_to_Head_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>RegistrationChecklistSubmitted_to_false1</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Sales_checklist_to_false</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Rejection_Date1</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>unfiled$public/EYI_Registration_Checklist</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.IsRegistrationChecklistSubmitted__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.EYI_Registration_Approval_Status__c</field>
            <operation>notEqual</operation>
            <value>CRM Head Approved</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_Registration_Status_to_Pending</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Rejection_Date_to_Null</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Registration Checklist Approval</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>3</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
