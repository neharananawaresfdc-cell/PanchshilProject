<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Docket_handover_should_not_future_date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(   EYI_IsAutomationBypassed__c  =false ,  ISCHANGED(  EYI_Disbursement_Docket_Handed_Over_Date__c  ) ,NOT( ISNULL(EYI_Disbursement_Docket_Handed_Over_Date__c))
,EYI_Disbursement_Docket_Handed_Over_Date__c &gt; TODAY() )</errorConditionFormula>
    <errorDisplayField>EYI_Disbursement_Docket_Handed_Over_Date__c</errorDisplayField>
    <errorMessage>Please enter valid Disbursement Docket Handed Over Date.</errorMessage>
</ValidationRule>
