<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Correspondence_1_Pincode_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL( EYI_Correspondence_Country__c , &quot;India&quot;),
NOT(REGEX( EYI_Correspondence_Pincode_Office__c, &quot;^[1-9][0-9]{5}$&quot;))
)</errorConditionFormula>
    <errorDisplayField>EYI_Correspondence_Pincode_Office__c</errorDisplayField>
    <errorMessage>Please enter a valid 6-digit pincode.</errorMessage>
</ValidationRule>
