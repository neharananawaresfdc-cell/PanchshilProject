<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Anniversary_Date_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    EYI_Anniversary_Date__c &gt; TODAY(),
    EYI_IsAutomationBypassed__c = false
)</errorConditionFormula>
    <errorDisplayField>EYI_Anniversary_Date__c</errorDisplayField>
    <errorMessage>Anniversary Date cannot be in the future. Please enter a valid date.</errorMessage>
</ValidationRule>
