<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Birth_date_should_be_Past</fullName>
    <active>true</active>
    <errorConditionFormula>AND( EYI_Birth_Date__c  &gt; TODAY(),EYI_IsAutomationBypassed__c = false)</errorConditionFormula>
    <errorDisplayField>EYI_Birth_Date__c</errorDisplayField>
    <errorMessage>DOB cannot be in the future. Please enter a valid date.</errorMessage>
</ValidationRule>
