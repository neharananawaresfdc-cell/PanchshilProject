<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Team_Size_should_not_be_0</fullName>
    <active>true</active>
    <errorConditionFormula>AND(  EYI_REC_Team_Size__c &lt;1 ,EYI_IsAutomationBypassed__c = false)</errorConditionFormula>
    <errorDisplayField>EYI_REC_Team_Size__c</errorDisplayField>
    <errorMessage>Please enter valid Team Size.</errorMessage>
</ValidationRule>
