<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Advisor_should_not_reopen_status</fullName>
    <active>true</active>
    <description>After Lead is lost presales advisor should be able to reopen the Lead Enquiry</description>
    <errorConditionFormula>AND(
ISCHANGED(  EYI_Lead_Status__c  )
,EYI_IsAutomationBypassed__c == false
,ISPICKVAL(PRIORVALUE(EYI_Lead_Status__c), &apos;Lost&apos;)
,$UserRole.Name = &apos;Pre-Sales Advisor&apos;
)</errorConditionFormula>
    <errorMessage>You cannot re-open the Lost Lead Enquiry</errorMessage>
</ValidationRule>
