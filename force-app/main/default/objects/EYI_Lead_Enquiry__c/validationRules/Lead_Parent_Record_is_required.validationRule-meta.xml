<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Parent_Record_is_required</fullName>
    <active>true</active>
    <description>Lead Parent Record is required.</description>
    <errorConditionFormula>AND( EYI_IsAutomationBypassed__c = false,ISBLANK(EYI_Parent_Record__c))</errorConditionFormula>
    <errorDisplayField>EYI_Parent_Record__c</errorDisplayField>
    <errorMessage>Lead Parent Record is required.</errorMessage>
</ValidationRule>
