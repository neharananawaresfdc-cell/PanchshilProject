<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EYI_Is_Lead_Enquiry_is_New__c</fullName>
    <description>This field is used to check weather Lead enquiry is new or Existing!</description>
    <externalId>false</externalId>
    <formula>IF(
    TEXT(YEAR(DATEVALUE(CreatedDate))) &amp; &quot;-&quot; &amp; 
    TEXT(MONTH(DATEVALUE(CreatedDate))) &amp; &quot;-&quot; &amp; 
    TEXT(DAY(DATEVALUE(CreatedDate))) &amp; &quot; &quot; &amp; 
    MID(TEXT(CreatedDate), 12, 2) =
    TEXT(YEAR(DATEVALUE(EYI_Parent_Record__r.CreatedDate))) &amp; &quot;-&quot; &amp; 
    TEXT(MONTH(DATEVALUE(EYI_Parent_Record__r.CreatedDate))) &amp; &quot;-&quot; &amp; 
    TEXT(DAY(DATEVALUE(EYI_Parent_Record__r.CreatedDate))) &amp; &quot; &quot; &amp; 
    MID(TEXT(EYI_Parent_Record__r.CreatedDate), 12, 2),
    &quot;New&quot;,
    &quot;Existing&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Lead Enquiry is New?</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
