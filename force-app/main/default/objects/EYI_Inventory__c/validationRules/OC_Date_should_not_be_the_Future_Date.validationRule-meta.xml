<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>OC_Date_should_not_be_the_Future_Date</fullName>
    <active>true</active>
    <errorConditionFormula>EYI_OC_Received_Date__c  &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>EYI_OC_Received_Date__c</errorDisplayField>
    <errorMessage>OC Received Date cannot be in the future.</errorMessage>
</ValidationRule>
