<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Opportunity_already_has_tag_inventory</fullName>
    <active>false</active>
    <errorConditionFormula>AND(EYI_IsAutomationBypassed__c = false,ISBLANK( EYI_Opportunity__r.EYI_Inventory__c))</errorConditionFormula>
