<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EYI_Total__c</fullName>
    <description>It will calculate Market Value + 4 Wheeler Parking Value +  MSEB Charges</description>
    <formula>EYI_Market_Value__c  +  EYI_Total_4_Wheeler_Parking_Value__c +  EYI_MSEB_Charges__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
