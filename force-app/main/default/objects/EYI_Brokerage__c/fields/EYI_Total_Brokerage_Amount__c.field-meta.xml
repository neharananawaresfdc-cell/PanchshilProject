<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EYI_Total_Brokerage_Amount__c</fullName>
    <description>Calculate brokerage value.</description>
    <formula>(EYI_Appartment_Value__c * EYI_Brokerage_percentage__c) +
IF(
    NOT(ISBLANK(EYI_Additional_Brokerage_Amount__c)),
    EYI_Additional_Brokerage_Amount__c,
    0
)</formula>
    <label>Total Brokerage Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
