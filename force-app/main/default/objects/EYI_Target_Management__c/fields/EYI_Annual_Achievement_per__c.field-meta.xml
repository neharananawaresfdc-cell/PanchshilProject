<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EYI_Annual_Achievement_per__c</fullName>
    <formula>IF(
    EYI_Total_Annual_Target__c &gt; 0,
    EYI_Annual_Achievement__c / EYI_Total_Annual_Target__c,
    0
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Annual Achievement %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
