<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>flow to automatically log callout data received via platform events</description>
    <environments>Default</environments>
    <interviewLabel>EYI_ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EYI Callout Logging Handler</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Callout_Log</name>
        <label>Callout Log</label>
        <locationX>176</locationX>
        <locationY>170</locationY>
        <inputAssignments>
            <field>Endpoint__c</field>
            <value>
                <elementReference>$Record.Endpoint__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>HttpStatusCode__c</field>
            <value>
                <elementReference>$Record.HttpStatusCode__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RequestBody__c</field>
            <value>
                <elementReference>$Record.RequestBody__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RequestTime__c</field>
            <value>
                <elementReference>$Record.RequestTime__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ResponseBody__c</field>
            <value>
                <elementReference>$Record.ResponseBody__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ResponseTime__c</field>
            <value>
                <elementReference>$Record.ResponseTime__c</elementReference>
            </value>
        </inputAssignments>
        <object>CalloutLog__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Callout_Log</targetReference>
        </connector>
        <flowRunAsUser>TriggeringUser</flowRunAsUser>
        <object>Callout_Log__e</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Active</status>
</Flow>
