    <formulas>
        <name>frankingvalue</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Stamp_Duty__c} + {!$Record.EYI_Registration_Charges__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ISNEW</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>OpportunitySource</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Opportunity.EYI_Walk_in_Sub_source__c})+ &apos; &apos;+ TEXT({!$Record.Opportunity.EYI_Walk_in_Source__c})+ &apos; Discount&apos;</expression>
    </formulas>
    <formulas>
        <name>PaymentPlanNameAuto</name>
        <dataType>String</dataType>
        <expression>{!Get_payment_plan_of_Quote.Project__r.Name}+&apos; &apos;+ TEXT({!Get_payment_plan_of_Quote.EYI_Plan_Type__c}) + &apos; &apos;
+
{!$Record.Opportunity.EYI_Opportunity_Number__c} + &apos; &apos;
+
{!$Record.QuoteNumber} + &apos; &apos;
+
TEXT(TODAY())</expression>
    </formulas>
