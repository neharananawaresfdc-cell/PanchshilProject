    <decisions>
        <name>Verify_Total_SD_Amount_Received_should_not_greater_that_SD_Amount_Paid</name>
        <label>Verify &apos;Total SD Amount Received&apos; should not greater that &apos;SD Amount Paid&apos;</label>
        <locationX>446</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SD_Amount_Paid_Total_SD_Amount_Received</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>currentValueOfSDAmount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Total_SD_Amount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Addition_of_SD_Paid_Amount</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity</targetReference>
            </connector>
            <label>SD Amount Paid &lt; Total SD Amount Received</label>
        </rules>
        <rules>
            <name>SD_Amount_Paid_Total_SD_Amount_Received1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>currentValueOfSDAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Total_SD_Amount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Addition_of_SD_Paid_Amount</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_0</targetReference>
            </connector>
            <label>SD Amount Paid = Total SD Amount Received</label>
        </rules>
        <rules>
            <name>SD_Amount_Paid_Total_SD_Amount_Received2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>currentValueOfSDAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>SD_Balance_Amount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Addition_of_SD_Paid_Amount</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Update_Opportunity</targetReference>
            </connector>
            <label>SD Amount Paid &gt; Total SD Amount Received</label>
        </rules>
    </decisions>
