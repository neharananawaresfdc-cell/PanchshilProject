    </assignments>
    <decisions>
        <name>Check_bussiness_hours</name>
        <label>Check bussiness hours</label>
        <locationX>182</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>Update_working_hours_to_false</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Missed call is in bussiness hours</defaultConnectorLabel>
        <rules>
            <name>Missed_call_is_in_bussiness_hours</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>fcreatedDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>fFiveThirthyPM</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fcreatedDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>fninethirtyAM</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_working_hours_to_true</targetReference>
            </connector>
            <label>Missed call is in bussiness hours</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Call_Type</name>
        <label>Check Call Type</label>
        <locationX>776</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Its_missed_call</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.tdc_360CTI__Call_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Missed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.tdc_360CTI__Related_Object_Id__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>a0Z</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_bussiness_hours</targetReference>
            </connector>
            <label>Its missed call</label>
        </rules>
        <rules>
            <name>Not_Missed_call</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.tdc_360CTI__Call_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Incoming</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.tdc_360CTI__Call_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Outgoing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.tdc_360CTI__Related_Object_Id__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>a0Z</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lead_Inquiry</targetReference>
            </connector>
            <label>Not Missed call</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_call_type_is_outgoing</name>
        <label>Check if call type is outgoing</label>
        <locationX>710</locationX>
        <locationY>1008</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_its_outgoing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.tdc_360CTI__Call_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Outgoing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.tdc_360CTI__List__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Calling_list_to_Null</targetReference>
            </connector>
            <label>Yes its outgoing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Lead_found</name>
        <label>Lead found</label>
        <locationX>908</locationX>
        <locationY>492</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_Inquiry</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>iterate_over_lead</targetReference>
            </connector>
            <label>yes</label>
        </rules>
    </decisions>
    <description>360  CTI Team by SS</description>
    <environments>Default</environments>
    <formulas>
        <name>fcallerNumberIncoming</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.tdc_360CTI__Call_From__c}, 10)</expression>
    </formulas>
    <formulas>
        <name>fcallerNumberOutgoing</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.tdc_360CTI__Call_To__c}, 10)</expression>
    </formulas>
    <formulas>
        <name>fcreatedDate</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!$Record.CreatedDate})</expression>
    </formulas>
    <formulas>
        <name>fCustomerNumber</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.tdc_360CTI__Call_Type__c} = &apos;Outgoing&apos;, {!fcallerNumberOutgoing}, {!fcallerNumberIncoming})</expression>
    </formulas>
    <formulas>
        <name>fFiveThirthyPM</name>
        <dataType>DateTime</dataType>
        <expression>( DATETIMEVALUE( TEXT(DATEVALUE({!$Record.CreatedDate})) + &apos; &apos; + &apos;18:30:00&apos;) - (5.5/24))</expression>
    </formulas>
    <formulas>
        <name>fninethirtyAM</name>
        <dataType>DateTime</dataType>
        <expression>( DATETIMEVALUE( TEXT(DATEVALUE({!$Record.CreatedDate})) + &apos; &apos; + &apos;09:30:00&apos;) - (5.5/24))</expression>
    </formulas>
    <interviewLabel>Update lead enqiry when call record is created {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update lead enqiry when call record is created</label>
    <loops>
