        <label>assign lead</label>
        <locationX>798</locationX>
        <locationY>708</locationY>
        <assignmentItems>
            <assignToReference>vsinglelead.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>iterate_over_lead.Id</elementReference>
            </value>
        </assignmentItems>
