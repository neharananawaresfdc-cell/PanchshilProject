    <formulas>
        <name>BirthDay_Notification_to_REC</name>
        <dataType>String</dataType>
        <expression>&apos;{&quot;recipient&quot;:&quot;EYI_Mobile__c&quot;,&quot;templateId&quot;:&quot;&apos; + $Label.WhatsApp_Template_for_BirthDay + &apos;&quot;,&quot;recordId&quot;:&quot;&apos; + {!$Record.Id} + &apos;&quot;}&apos;</expression>
    </formulas>
    <formulas>
        <name>Check_Anniversary</name>
        <dataType>String</dataType>
        <expression>&apos;{&quot;recipient&quot;:&quot;EYI_Mobile__c&quot;,&quot;templateId&quot;:&quot;&apos; + $Label.Whatsapp_Template_for_Anniversary + &apos;&quot;,&quot;recordId&quot;:&quot;&apos; + {!$Record.Id} + &apos;&quot;}&apos;</expression>
    </formulas>
    <formulas>
        <name>Check_Anniversary_Date</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    MONTH({!$Record.EYI_Anniversary_Date__c}) = MONTH(TODAY()),
    DAY({!$Record.EYI_Anniversary_Date__c}) = DAY(TODAY())
)</expression>
    </formulas>
    <formulas>
        <name>check_BirthDate</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    MONTH({!$Record.EYI_Birth_Date__c}) = MONTH(TODAY()),
    DAY({!$Record.EYI_Birth_Date__c}) = DAY(TODAY())
)</expression>
    </formulas>
    <formulas>
        <name>CheckExpiry</name>
        <dataType>Boolean</dataType>
        <expression>TODAY() - {!$Record.EYI_RERA_Expiry_Date__c} = 30</expression>
    </formulas>
    <formulas>
        <name>RERA_Expiry</name>
        <dataType>Number</dataType>
        <expression>ABS(TODAY() - {!$Record.EYI_RERA_Expiry_Date__c})</expression>
        <scale>0</scale>
    </formulas>
