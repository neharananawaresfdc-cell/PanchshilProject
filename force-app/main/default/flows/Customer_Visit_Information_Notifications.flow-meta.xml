        <rules>
            <name>Source_is_REC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EYI_Opportunity__r.EYI_Walk_in_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PREC</stringValue>
