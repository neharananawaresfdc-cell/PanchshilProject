    <textTemplates>
        <name>FreshVisit_EmailBody_REC</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Dear {!$Record.EYI_Opportunity__r.EYI_REC__r.Name},

We are pleased to inform you that your referred customer, {!$Record.EYI_Opportunity__r.Name}, has scheduled their visit to {!$Record.EYI_Opportunity__r.EYI_Project_Enquired__r.Name}.

Visit Details:
•	Customer Name: {!$Record.EYI_Opportunity__r.Name}
•	Date &amp; Time: {!$Record.EYI_Visit_Date_Time__c}
•	Unit Details: {!$Record.EYI_Opportunity__r.EYI_Project_Unit__c}
•	Sales Manager: {!$Record.EYI_Opportunity__r.EYI_Primary_Closing_Manager__r.Name} {!$Record.EYI_Opportunity__r.EYI_Primary_Closing_Manager__r.MobilePhone}

Please ensure all necessary preparations are in place

Best regards,
Team Panchshil</text>
    </textTemplates>
