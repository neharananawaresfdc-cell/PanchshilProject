            </conditions>
            <conditions>
                <leftValueReference>$Record.EYI_Opportunity__r.EYI_REC__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_WhatsApp_Notification_Fresh_visit_REC</targetReference>
            </connector>
            <label>Source is REC</label>
        </rules>
