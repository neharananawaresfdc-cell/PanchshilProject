    <decisions>
        <name>Check_Brokerage_amount</name>
        <label>Check Brokerage amount</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Amount_is_paid_9_9</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EYI_Total_Pending_Booking_Amount_in_Per__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>90.1</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Brokerage_for_Amount_Paid</targetReference>
            </connector>
            <label>Amount is paid 9.9%</label>
        </rules>
        <rules>
            <name>Amount_is_not_paid_9_9</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EYI_Total_Pending_Booking_Amount_in_Per__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>90.1</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Brokerage_for_Amount_Remaining</targetReference>
            </connector>
            <label>Amount is not paid 9.9%</label>
        </rules>
    </decisions>
    <description>Update Brokerage Per from Project v1</description>
    <environments>Default</environments>
    <formulas>
        <name>AppartmentValue</name>
        <dataType>Number</dataType>
        <expression>({!Base_Charges} - {!Base_Rate_Discount} - {!Floor_Rate_Discount})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>BrokeragePercent</name>
        <dataType>Number</dataType>
        <expression>{!Get_Project_Records.EYI_Brokerage__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FinalBrokerageAmount</name>
        <dataType>Number</dataType>
        <expression>(({!Base_Charges} - {!Base_Rate_Discount} - {!Floor_Rate_Discount}) * VALUE({!get_Brokerage_Percent}))/100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>get_Brokerage_Percent</name>
        <dataType>String</dataType>
        <expression>{!$Label.Brokerage_Percent}</expression>
    </formulas>
