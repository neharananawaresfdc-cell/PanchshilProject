<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Call_log_found</name>
        <label>Call log found?</label>
        <locationX>438</locationX>
        <locationY>648</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yess</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_call_log</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_call_log</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Enquiry_record_found</name>
        <label>Enquiry record found?</label>
        <locationX>636</locationX>
        <locationY>432</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_latest_Lead_enquiry_record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_call_log</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>360 Automation by SK</description>
    <environments>Default</environments>
    <interviewLabel>Associate Call log with {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Associate Call log with lead enquiry</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_call_log</name>
        <label>get call log</label>
        <locationX>438</locationX>
        <locationY>540</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Call_log_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>tdc_360CTI__Related_Object_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>tdc_360CTI__Call_Log__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_latest_Lead_enquiry_record</name>
        <label>get latest Lead enquiry record</label>
        <locationX>636</locationX>
        <locationY>324</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Enquiry_record_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EYI_Parent_Record__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EYI_Lead_Enquiry__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_call_log</name>
        <label>Update call log</label>
        <locationX>306</locationX>
        <locationY>756</locationY>
        <connector>
            <targetReference>update_task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>get_call_log.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CustomLead_Enquiry__c</field>
            <value>
                <elementReference>get_latest_Lead_enquiry_record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>tdc_360CTI__Lead__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>tdc_360CTI__Related_Object_Id__c</field>
            <value>
                <elementReference>get_latest_Lead_enquiry_record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>tdc_360CTI__Related_Object__c</field>
            <value>
                <stringValue>EYI_Lead_Enquiry__c</stringValue>
            </value>
        </inputAssignments>
        <object>tdc_360CTI__Call_Log__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>update_task</name>
        <label>update task</label>
        <locationX>306</locationX>
        <locationY>864</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>get_call_log.tdc_360CTI__Related_Task_Id__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>EYI_Next_Action_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EYI_Next_Action_Time__c</field>
            <value>
                <stringValue>05:30 PM - 06:30 PM</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>get_latest_Lead_enquiry_record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
        </inputAssignments>
        <object>Task</object>
    </recordUpdates>
    <start>
        <locationX>444</locationX>
        <locationY>48</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CTI</stringValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <scheduledPaths>
            <name>After_2_min_later</name>
            <connector>
                <targetReference>get_latest_Lead_enquiry_record</targetReference>
            </connector>
            <label>After 2 min later</label>
            <offsetNumber>2</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
