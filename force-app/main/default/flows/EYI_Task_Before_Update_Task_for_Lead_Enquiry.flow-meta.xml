    <description>This flow auto close the previous tasks on the lead, when a new task is created.
This flow auto close the tasks if the there are no action needed.</description>
    <environments>Default</environments>
    <formulas>
        <name>CallStatus</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.tdc_360CTI__Call_Log__r.tdc_360CTI__Answered_Seconds__c} &gt; 9, &apos;Connected&apos;, &apos;Not Connected&apos;)</expression>
    </formulas>
    <formulas>
        <name>CheckRecordCreateUpdate</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>CommunicationType</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!$Record.tdc_360CTI__Call_Log__r.tdc_360CTI__Call_Type__c}, &apos;Incoming&apos;) , &apos;Inbound Call&apos;,&apos;Outbound Call&apos;)</expression>
    </formulas>
    <formulas>
        <name>ConvTimetoTextTime</name>
        <dataType>String</dataType>
        <expression>IF(
        CONTAINS({!GenStartTimefromNextActionTimeSlot}, &quot;PM&quot;) &amp;&amp; VALUE(LEFT({!GenStartTimefromNextActionTimeSlot}, FIND(&quot;:&quot;, {!GenStartTimefromNextActionTimeSlot}) - 1)) &lt; 12,
        TEXT(VALUE(LEFT({!GenStartTimefromNextActionTimeSlot}, FIND(&quot;:&quot;, {!GenStartTimefromNextActionTimeSlot}) - 1)) + 12) &amp; &quot;:&quot; &amp; MID({!GenStartTimefromNextActionTimeSlot}, FIND(&quot;:&quot;, {!GenStartTimefromNextActionTimeSlot}) + 1, 2),
        IF(
            CONTAINS({!GenStartTimefromNextActionTimeSlot}, &quot;AM&quot;) &amp;&amp; LEFT({!GenStartTimefromNextActionTimeSlot}, 2) = &quot;12&quot;,
            &quot;00:&quot; &amp; MID({!GenStartTimefromNextActionTimeSlot}, FIND(&quot;:&quot;, {!GenStartTimefromNextActionTimeSlot}) + 1, 2),
            LEFT({!GenStartTimefromNextActionTimeSlot}, FIND(&quot;:&quot;, {!GenStartTimefromNextActionTimeSlot}) + 2)
        )
    )</expression>
    </formulas>
    <formulas>
        <name>GenStartTimefromNextActionTimeSlot</name>
        <dataType>String</dataType>
        <expression>LEFT(TEXT({!$Record.EYI_Next_Action_Time__c}), FIND(&quot; -&quot;, TEXT({!$Record.EYI_Next_Action_Time__c})) - 1)</expression>
    </formulas>
    <formulas>
        <name>NextActionDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
    TEXT({!$Record.EYI_Next_Action_Date__c}) &amp; &quot; &quot; &amp; {!ConvTimetoTextTime} &amp;&quot;:00&quot;)</expression>
    </formulas>
    <formulas>
        <description>To be set as reminder date time</description>
        <name>ReminderDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
    TEXT({!$Record.EYI_Next_Action_Date_Time__c})) - (5.5+(5/60))/24</expression>
    </formulas>
